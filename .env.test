NODE_ENV=test
PORT=3334
DATABASE_URL=postgres://postgres:postgres@localhost:6001/blog_test
UPLOAD_DIR=tmp/uploads-test

# Mailpit de teste (docker compose: mailpit_test). API HTTP em http://localhost:8026
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_FROM=Blog API <no-reply@blog.local>
SMTP_USER=
SMTP_PASS=

# API HTTP do Mailpit de teste (usada só pelos helpers dos testes, não pela app)
MAILPIT_API_URL=http://localhost:8026

# Redis das filas (docker compose: redis). Mesmo Redis de dev, com prefixo próprio para os jobs
# de teste não serem consumidos por uma API de dev rodando. Painel: bullboard_test (:3001).
REDIS_URL=redis://localhost:6379
QUEUE_PREFIX=bull-test
