NODE_ENV=development
PORT=
DATABASE_URL=
UPLOAD_DIR=uploads

# SMTP do e-mail de nova reply. Em dev: Mailpit (docker compose), caixa em http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=Blog API <no-reply@blog.local>
SMTP_USER=
SMTP_PASS=

# Redis (docker compose: redis)
REDIS_URL=redis://localhost:6379
# Prefixo das chaves das filas BullMQ (o Bull Board lê "bull")
QUEUE_PREFIX=bull

# Bull Board (docker compose: bullboard, http://localhost:3000) — basic auth do painel
BULL_BOARD_USER=admin
BULL_BOARD_PASSWORD=admin
